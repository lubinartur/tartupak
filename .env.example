# Resend (contact form email)
RESEND_API_KEY=
# Recipient of quote requests (falls back to maksim@tartupak.ee)
RESEND_TO_EMAIL=

# Cloudflare Turnstile (contact form bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Tag Manager container (analytics + Google Ads). Leave empty to disable tracking and the cookie banner.
NEXT_PUBLIC_GTM_ID=
